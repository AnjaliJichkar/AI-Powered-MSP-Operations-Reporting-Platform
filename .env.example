# Copy to .env for local development. Never commit .env.
# Every value here is read by app/settings.py. No secret is ever hard-coded.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# A bare postgresql:// URL is rewritten to the asyncpg driver automatically.
DATABASE_URL=postgresql+asyncpg://inputiv:inputiv@localhost:5432/inputiv
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Credential encryption ---------------------------------------------
# ToolCredential secrets are encrypted at rest with these keys.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The map is key_id -> key, so old keys stay available for decryption after rotation.
CREDENTIAL_ENCRYPTION_KEYS={"v1": "REPLACE_ME_WITH_A_GENERATED_FERNET_KEY"}
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=v1

# --- Anthropic ----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
# low | medium | high | xhigh | max. Lower for faster chat, higher for depth.
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_RETRIES=2

# --- Web search ---------------------------------------------------------
# Anthropic's server-side web search, for vendor error codes, KB articles,
# CVEs and end-of-life dates. Every search is audited (query + URLs).
WEB_SEARCH_ENABLED=true
# Searches the model may make while answering one question.
WEB_SEARCH_MAX_USES=3
# Optional, comma-separated bare domains. When set, results come only from these.
# WEB_SEARCH_ALLOWED_DOMAINS=ninjaone.com,autotask.net,learn.microsoft.com,nvd.nist.gov

# Business reviews research Industry Trends with their own allowlist, separate from the
# chat agent's above: regulators, standards bodies and industry associations. The default
# is cisa.gov, nist.gov, ic3.gov, ftc.gov, hhs.gov, sec.gov and the recognised associations
# listed in app/settings.py (DEFAULT_REPORT_DOMAINS). Vendor domains are refused at startup,
# and so is an empty list: report research is never unrestricted.
# REPORT_WEB_SEARCH_ALLOWED_DOMAINS=cisa.gov,nist.gov,ic3.gov,ftc.gov,hhs.gov,sec.gov,americanbar.org
# REPORT_WEB_SEARCH_MAX_USES=6

# --- Connector behaviour (hard rule 6: configuration, not constants) ----
CONNECTOR_TIMEOUT_SECONDS=30
CONNECTOR_CONNECT_TIMEOUT_SECONDS=10
# One vendor's own read timeout, overriding the shared one for it alone.
# GravityZone's inventory pages can take a minute or more (validation log,
# 2026-09-28); the others take the shared value unless set here.
BITDEFENDER_TIMEOUT_SECONDS=120
# NINJAONE_TIMEOUT_SECONDS=
# AUTOTASK_TIMEOUT_SECONDS=
# CONNECTSECURE_TIMEOUT_SECONDS=
CONNECTOR_MAX_RETRIES=3
CONNECTOR_BACKOFF_BASE_SECONDS=0.5
CONNECTOR_BACKOFF_MAX_SECONDS=20
CONNECTOR_PAGE_SIZE=100
CONNECTOR_MAX_PAGES=20

# --- NinjaOne -----------------------------------------------------------
# Per-organisation requests in flight at once when a read fans out (alerts).
NINJAONE_CONCURRENCY=5
# How long a tenant-wide device inventory is reused before NinjaOne is asked
# again; count_devices and list_devices read from it. 0 disables the cache.
NINJAONE_INVENTORY_TTL_SECONDS=180
# Page size for GET /v2/devices. The spec declares no maximum; the listing
# pages until an empty page, so a silent vendor cap cannot truncate it.
NINJAONE_DEVICES_PAGE_SIZE=1000
# Page size for the /v2/queries/* reports (patches, volumes, software, ...).
# The spec declares no maximum; 5000 was honoured live.
NINJAONE_QUERY_PAGE_SIZE=5000

# --- Bitdefender GravityZone ------------------------------------------
# The API key is stored per client with manage_client.py set-credentials
# --connector bitdefender (BITDEFENDER_API_KEY in the environment when you
# run it); it never goes in this file. The key cannot be made read-only by
# the vendor: the connector refuses every non-read method itself.
# Per-company requests in flight at once; getNetworkInventoryItems is
# limited to 5 per second per key.
BITDEFENDER_CONCURRENCY=4
BITDEFENDER_INVENTORY_TTL_SECONDS=180
# getNetworkInventoryItems allows 1 to 1000 per page.
BITDEFENDER_PAGE_SIZE=1000
# getManagedEndpointDetails.lastSeen is one call per row. It is read only for
# GravityZone rows paired with devices NinjaOne has lost for less than
# DEVICE_RETIRE_DAYS, kept on the device link, and asked again only when the
# kept value is older than this many hours (0: every run).
BITDEFENDER_LAST_SEEN_REFRESH_HOURS=12
# Detail calls in flight at once during that read.
BITDEFENDER_DETAIL_CONCURRENCY=4

# --- ConnectSecure ------------------------------------------------------
# The client id and secret are stored per client with manage_client.py
# set-credentials --connector connectsecure (CONNECTSECURE_CLIENT_ID and
# CONNECTSECURE_CLIENT_SECRET in the environment when you run it, plus
# --tenant and --base-url or --pod, prompted for if absent); they never go
# in this file. The key's user role is the write surface: the connector
# sends only the login and allowlisted GETs itself.
CONNECTSECURE_CONCURRENCY=4
CONNECTSECURE_INVENTORY_TTL_SECONDS=180
# The first request's `limit`; a listing is read as one page sized to the
# vendor's total, up to CONNECTSECURE_MAX_ROWS (then reported truncated).
CONNECTSECURE_PAGE_SIZE=10000
CONNECTSECURE_MAX_ROWS=50000
# An asset not scanned for this many days is a coverage gap.
CONNECTSECURE_STALE_SCAN_DAYS=30

# Output tokens one business-review section's draft may use. How many findings
# a slide holds is not configurable: it is measured from the template
# (app/reports/tbr/layout.py).
REPORT_SECTION_MAX_TOKENS=3000

# --- Agent run caps (hard rule 6: configuration, not constants) ---------
MAX_TOOL_CALLS=8
TOOL_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=120
# Rows a list tool hands the model in one result; beyond this it reports
# total and truncated: true instead of growing.
TOOL_MAX_ROWS=200

# --- Conversation threads -----------------------------------------------
# Estimated input tokens of thread history replayed on a turn. Over this, old
# tool results are stubbed out, then whole old turns dropped (the stored
# thread is never edited); a context_trimmed audit row records what went.
CONVERSATION_CONTEXT_BUDGET=80000
# The newest turns trimming never touches.
CONVERSATION_KEEP_RECENT_TURNS=4

# --- Authentication -----------------------------------------------------
# Sessions are rows; the cookie holds a random token and nothing else.
SESSION_COOKIE_NAME=inputiv_session
# Idle closes a session left alone; absolute is set at sign-in and never
# extended, so a stolen session cannot be kept alive by using it.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# A Secure cookie is not sent over http, so this is false only for local http
# development. Settings refuse false anywhere but ENVIRONMENT=local.
SESSION_COOKIE_SECURE=true
# Where a browser without a session is sent.
LOGIN_PATH=/login

# Sign-in throttling. The lockout is per account and is a column, so it
# survives a restart; the rate limit is per client address and in memory, so
# it sees one caller trying many accounts. Both are needed.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# argon2id cost. Raising these is safe at any time: a stored hash carries the
# parameters it was made with and is upgraded on the owner's next sign-in.
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_PARALLELISM=4

# Where this deployment answers, as somebody outside it would type it. Used to
# build the invitation link, which is useless as a bare token. It must be https
# anywhere but ENVIRONMENT=local, because that link carries a one-time token —
# settings refuse to start otherwise, so a deployment cannot quietly email
# links to localhost.
PUBLIC_BASE_URL=http://localhost:8000

# How long an invite link is good for, and what an authenticator app shows.
INVITE_EXPIRY_HOURS=72
TOTP_ISSUER=Inputiv
# Inputiv staff must hold a confirmed second factor. Off is for a laptop only:
# refused outside ENVIRONMENT=local (docs/deploy.md, step 3).
TOTP_REQUIRED_FOR_INPUTIV=false

# --- Slack --------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Tests --------------------------------------------------------------
# Optional. When set, tests marked `postgres` run against this database.
# TEST_DATABASE_URL=postgresql+asyncpg://inputiv:inputiv@localhost:5432/inputiv_test

# --- Reports ---
# Rendered business reviews (TBR decks) are written here. They hold customer data.
# REPORTS_DIR=var/reports
